# =====================================================================
#  SpeakMate AI — Environment Variables
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# ---- Database (PostgreSQL) ----
# Example (local): postgresql://postgres:postgres@localhost:5432/speakmate?schema=public
# Managed providers (Neon, Supabase, Vercel Postgres) typically require TLS —
# append `?sslmode=require` to the connection string (Supabase pooled connections
# also use the `-pooler` host and port 6543). Get a free database at:
#   Neon             https://neon.tech
#   Supabase         https://supabase.com
#   Vercel Postgres  https://vercel.com/docs/storage/vercel-postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/speakmate?schema=public"

# ---- Auth ----
# Random string used to sign session JWTs. Must be at least 32 characters or
# startup fails. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Canonical app URL used to build OAuth callback URLs
# ({AUTH_URL}/api/auth/callback/{provider}). Local dev: http://localhost:3000
# (NEXTAUTH_URL is accepted as an alias.)
AUTH_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
# Obtain credentials at https://console.cloud.google.com/apis/credentials .
# Google sign-in is enabled only when BOTH values are set. Leave empty to disable.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- GitHub OAuth (optional) ---
# Obtain credentials at https://github.com/settings/developers .
# GitHub sign-in is enabled only when BOTH values are set. Leave empty to disable.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- AI Provider ----
# Which provider the AI service layer uses.
#   "local"  -> built-in rule-based tutor (no network, works offline, default)
#   "gemini" -> Google Gemini API (requires GEMINI_API_KEY below)
#   "openai" -> OpenAI-compatible chat completions API (requires OPENAI_API_KEY)
AI_PROVIDER="local"

# --- Google Gemini (used when AI_PROVIDER=gemini) ---
# Get a key at https://aistudio.google.com/app/apikey . Server-side only —
# NEVER commit the real value; keep it in your local .env.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# --- OpenAI-compatible (used when AI_PROVIDER=openai) ---
OPENAI_API_KEY=""
# Base URL lets you point at any OpenAI-compatible endpoint (Azure, local LLM, etc.)
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ---- Speech (client-side by default) ----
# Speech-to-text and text-to-speech use the browser Web Speech API by default,
# which needs no keys. To swap in a cloud speech provider later, add its keys
# here and implement the adapter in src/lib/ai/providers.
SPEECH_PROVIDER="webspeech"
