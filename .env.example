# =====================================================================
#  Mira AI — Environment Variables
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =====================================================================

# ---- Database (PostgreSQL — for learning data, not auth) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/speakmate?schema=public"

# ---- Auth (session cookie signing) ----
# Generate with:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- Firebase Authentication ----
# NEXT_PUBLIC_ values are safe to commit — they identify your project but
# don't grant access. Security comes from Firebase Security Rules + Admin SDK.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyCombIOX1v3QT-qIfkn14B7_jtP2_xEzx4"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="mira-ai-ca492.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="mira-ai-ca492"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="mira-ai-ca492.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="82708260891"
NEXT_PUBLIC_FIREBASE_APP_ID="1:82708260891:web:56897045af882e9fc270be"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-4RR9S1NB22"

# Firebase Admin SDK (server-side token verification — KEEP SECRET)
# Option A: paste the full service-account JSON as one minified line (required
#           on Vercel / non-GCP hosts).
# Option B: leave blank on Cloud Run / GCP (uses Application Default Credentials).
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ---- AI Provider ----
# "local"  -> built-in offline rule-based tutor (default, no key needed)
# "gemini" -> Google Gemini API
# "openai" -> OpenAI-compatible endpoint
AI_PROVIDER="local"

# --- Google Gemini ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_LIVE_MODEL=""
GEMINI_TTS_MODEL=""
GEMINI_STT_MODEL=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# --- OpenAI-compatible ---
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ---- Speech ----
SPEECH_PROVIDER="webspeech"
